rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return true;
    }

    // Default Allow All Policy for full-stack e-commerce applet
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
