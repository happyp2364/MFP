{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/product/:id*",
      "destination": "/index.html"
    },
    {
      "source": "/products/:id*",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
