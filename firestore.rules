rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all for global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Safety Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        request.auth.token.email in [
          'vpcreation2002@gmail.com',
          'vishalpparihar2002@gmail.com',
          'marudharfashion2019@gmail.com',
          'marudharfashion@gmail.com',
          'admin@marudharfashionpoint.com'
        ]
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Public Products Catalog (Read-Only for Public, Admin-Only Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reusable Product Templates (Admin Managed)
    match /productTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Reviews & Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Store Info & Configuration Settings
    match /storeInfo/{infoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hangingSneakerConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /petShoeConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagramConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paymentSettings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Real Client Collections
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /homepage/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /homepage_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /homepage_versions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /payment/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /animations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mascot/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /social/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /theme/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /about/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_gallery_parts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_variants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_ai_metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /product_statistics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero/{heroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userEmail == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // Security Audit Logs
    match /auditLogs/{document=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() || (request.resource.data.customerPhone is string && request.resource.data.customerName is string);
      allow read: if true;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || request.resource.data.keys().hasAny(['paymentStatus', 'razorpayPaymentId', 'orderStatus']);
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }

    match /inventoryBackups/{backupId} {
      allow read, write: if isAdmin();
      match /chunks/{chunkId} {
        allow read, write: if isAdmin();
      }
    }

    match /publishedVersions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /admin_users/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admin_roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /marketingCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /marketingSubscribers/{subscriberId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.email == request.auth.token.email)) || (!isSignedIn() && (resource == null || resource.data.email == request.resource.data.email));
    }

    match /flashDeals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
